# TensorWire settings (spec Section 12). Copy to .env and fill in the REQUIRED values.
# Every value below is the default. Unknown TW_* variables are a startup error.
# Lines starting with "# TW_" are optional settings whose default is "unset".
# Never commit a real .env file.

# ---------------------------------------------------------------- common (12.1)
TW_NETWORK=test
TW_CHAIN_FALLBACKS=
# REQUIRED: subnet number
TW_NETUID=
# REQUIRED: coldkey wallet directory name (only the hotkey is read)
TW_WALLET_NAME=
TW_WALLET_HOTKEY=default
TW_WALLET_PATH=~/.bittensor/wallets
TW_REFUSE_IF_COLDKEY_PRESENT=1
TW_STATE_DIR=~/.tensorwire
TW_LOG_LEVEL=INFO
TW_METRICS_BIND=127.0.0.1:9100
TW_CHAIN_TIMEOUT_S=30
TW_METAGRAPH_REFRESH_S=120
# default: 900, capped at half the max age on short tempos (localnet)
# TW_METAGRAPH_SOFT_AGE_S=900
# default: 2 x the subnet's tempo in seconds (8640 at tempo 360)
# TW_METAGRAPH_MAX_AGE_S=8640
TW_METAGRAPH_STRICT=0
TW_STARTUP_TIMEOUT_S=120
TW_NTP_SERVERS=pool.ntp.org,time.cloudflare.com
# required when TW_WORKERS > 1 or TW_INSTANCE_COUNT > 1
TW_REDIS_URL=
# ServeAxon.protocol; the chain stores a u8 (0-255)
TW_PROTOCOL_TAG=87
# validators: http | https | https-if-tls-published (pin the key each miner published with
# ServeAxonTls; never plain HTTP for a miner that published one; spec 16.3)
TW_SCHEME_POLICY=http
# set 1 on localnet only
TW_ALLOW_PRIVATE_AXONS=0
# streaming routes (spec 9.2), enforced by miners and validators; routes and
# calls may override them: whole stream 1-600 s, bytes 1 KiB-64 MiB, gap between
# events 1-120 s
TW_STREAM_MAX_S=60
TW_STREAM_MAX_BYTES=4194304
TW_STREAM_IDLE_S=10
# open streams one caller hotkey may hold per miner process, 1-256 (D36); beyond: 429
TW_STREAM_MAX_PER_CALLER=16

# ---------------------------------------------------------------- miner (12.2)
TW_BIND_HOST=0.0.0.0
TW_BIND_PORT=8091
# REQUIRED for miners: public IP published on chain. Never 0.0.0.0, :: or
# 127.0.0.1 (the chain rejects or un-serves them); on localnet use 127.0.0.2
# (Linux) or the LAN IP, with TW_ALLOW_PRIVATE_AXONS=1
TW_EXTERNAL_IP=
# default: TW_BIND_PORT
# TW_EXTERNAL_PORT=8091
TW_AUTO_SERVE_AXON=1
# set 0 on all but one replica
TW_AXON_PUBLISHER=1
TW_INSTANCE_COUNT=1
TW_WORKERS=1
TW_AUTH_MAX_AGE_S=10
TW_AUTH_ALLOWED_SKEW_S=2
# must be >= 2 x (TW_AUTH_MAX_AGE_S + TW_AUTH_ALLOWED_SKEW_S), refused at startup otherwise (D27)
TW_NONCE_RETENTION_S=60
TW_MAX_BODY_BYTES=1048576
TW_RATE_IP_PER_S=50
TW_RATE_IP_BURST=100
TW_RATE_HOTKEY_PER_S=20
TW_RATE_HOTKEY_BURST=40
# comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted
TW_TRUSTED_PROXIES=
TW_REQUIRE_PERMIT=1
# suggest >= 1000 on mainnet
TW_MIN_CALLER_STAKE_TAO=0
TW_ALLOW_HOTKEYS=
TW_DENY_HOTKEYS=
TW_HANDLER_TIMEOUT_S=10
TW_SIGN_RESPONSES=1
TW_DRAIN_S=10
# ISO date (YYYY-MM-DD) until which v10 Dendrite requests are accepted;
# must be in the future and at most 180 days ahead
# TW_LEGACY_V10_UNTIL=2026-12-31
TW_COMPAT_MAX_QUEUE=256
# HTTPS directly from uvicorn: set both or neither; Ed25519 or EC P-256 key only,
# key file chmod 600; the miner publishes the key with ServeAxonTls (docs/security.md)
# TW_TLS_CERT_FILE=/etc/tensorwire/cert.pem
# TW_TLS_KEY_FILE=/etc/tensorwire/key.pem
# TLS at a reverse proxy instead: the proxy's public certificate, published with
# ServeAxonTls; needs TW_TRUSTED_PROXIES; not with TW_TLS_CERT_FILE
# TW_TLS_PUBLISHED_CERT_FILE=/etc/tensorwire/proxy-cert.pem
# do not use in production
TW_UNSAFE_ALLOW_MEMORY_NONCE_MULTIWORKER=0

# ---------------------------------------------------------------- validator (12.3)
TW_ROUND_INTERVAL_S=60
TW_SAMPLE_SIZE=64
TW_QUERY_TIMEOUT_S=12
TW_MAX_CONCURRENCY=64
TW_MAX_ATTEMPTS=2
TW_VERIFY_RESPONSES=1
TW_MAX_RESPONSE_BYTES=4194304
TW_SCORE_ALPHA=0.1
TW_MIN_WEIGHT_INTERVAL_BLOCKS=100
# must be >= the subnet's stored version key
TW_WEIGHTS_VERSION_KEY=0
TW_MECHID=0
TW_QUERY_VALIDATORS=0
TW_LEGACY_V10_CLIENT=off
# required when TW_LEGACY_V10_CLIENT=auto; in the future, at most 180 days ahead
# TW_LEGACY_V10_CLIENT_UNTIL=2026-12-31
# timelock (spec 8.10): concurrent drand fetches 1-64, retries 0-10, deadline of
# one open 1-300 s; drand trouble after that is tw.timelock_unavailable
TW_TIMELOCK_CONCURRENCY=8
TW_TIMELOCK_RETRIES=3
TW_TIMELOCK_TIMEOUT_S=30

# ---------------------------------------------------------------- sidecar (12.4, 11.6)
# `tensorwire sidecar` for TS/Go/Rust miners: binds 127.0.0.1 (or --host ::1) only.
# It uses TW_WALLET_* (the miner's hotkey), TW_NETUID, the chain settings above and,
# for GET /v1/caller, TW_REQUIRE_PERMIT, TW_MIN_CALLER_STAKE_TAO, TW_ALLOW_HOTKEYS,
# TW_DENY_HOTKEYS and TW_METAGRAPH_STRICT (miner section).
TW_SIDECAR_PORT=9910
# bearer token, generated with mode 0600 on first run, never logged;
# default: $TW_STATE_DIR/sidecar.token
# TW_SIDECAR_TOKEN_FILE=~/.tensorwire/sidecar.token
# 1 = allow --host other than 127.0.0.1 / ::1 (unsafe: logged, tw_unsafe_settings_active)
TW_SIDECAR_UNSAFE_BIND=0
