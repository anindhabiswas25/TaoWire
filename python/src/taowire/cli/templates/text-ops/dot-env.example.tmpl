# text-ops-subnet settings. Every TaoWire setting is a TW_* variable
# (docs: TaoWire spec Section 12). Copy to .env and fill in.
TW_NETWORK=local
TW_NETUID=2
TW_WALLET_PATH=~/.bittensor/wallets
TW_WALLET_HOTKEY=default

# Miner
TW_WALLET_NAME=miner
TW_EXTERNAL_IP=127.0.0.2
TW_BIND_PORT=8091
# localnet only: private/loopback axons and dev wallets with unencrypted coldkeys
TW_ALLOW_PRIVATE_AXONS=1
TW_REFUSE_IF_COLDKEY_PRESENT=0

# Validator (use a separate .env, or override TW_WALLET_NAME when starting it)
# TW_WALLET_NAME=validator
# TW_ROUND_INTERVAL_S=60
# TW_METRICS_BIND=127.0.0.1:9101
