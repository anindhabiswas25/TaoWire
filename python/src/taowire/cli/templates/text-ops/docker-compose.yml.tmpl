# Local run of text-ops-subnet next to a localnet chain (Linux).
#
# Start the chain and register the wallets first (TaoWire repo:
# scripts/localnet_up.sh), then:  docker compose up
# Host networking, so the miner can publish 127.0.0.2 and both reach the
# chain at ws://127.0.0.1:9944. Wallets are mounted read-only.
# Until TaoWire is on PyPI, build a wheel (cd python && uv build), copy it
# into ./vendor/ and set TAOWIRE_REQ=/app/vendor/<wheel file>.
services:
  redis:
    image: redis:7
    network_mode: host
    command: ["redis-server", "--bind", "127.0.0.1", "--port", "6380"]

  miner:
    image: python:3.12-slim
    network_mode: host
    working_dir: /app
    volumes:
      - .:/app:ro
      - ${WALLETS:-~/.taowire/localnet/wallets}:/wallets:ro
    environment:
      TW_NETWORK: local
      TW_NETUID: "2"
      TW_WALLET_PATH: /wallets
      TW_WALLET_NAME: miner_py
      TW_EXTERNAL_IP: 127.0.0.2
      TW_BIND_PORT: "8091"
      TW_ALLOW_PRIVATE_AXONS: "1"
      TW_REFUSE_IF_COLDKEY_PRESENT: "0"  # localnet dev wallets only
      TW_REDIS_URL: redis://127.0.0.1:6380/0
      TW_STATE_DIR: /tmp/taowire
      TW_METRICS_BIND: 127.0.0.1:9100
      TAOWIRE_REQ: ${TAOWIRE_REQ:-taowire}
    command: ["sh", "-c", "pip install -q $${TAOWIRE_REQ:-taowire} /app && python -m text_ops.miner"]
    depends_on: [redis]

  validator:
    image: python:3.12-slim
    network_mode: host
    working_dir: /app
    volumes:
      - .:/app:ro
      - ${WALLETS:-~/.taowire/localnet/wallets}:/wallets:ro
    environment:
      TW_NETWORK: local
      TW_NETUID: "2"
      TW_WALLET_PATH: /wallets
      TW_WALLET_NAME: validator
      TW_ALLOW_PRIVATE_AXONS: "1"
      TW_REFUSE_IF_COLDKEY_PRESENT: "0"  # localnet dev wallets only
      TW_STATE_DIR: /tmp/taowire
      TW_METRICS_BIND: 127.0.0.1:9101
      TW_ROUND_INTERVAL_S: "12"
      TAOWIRE_REQ: ${TAOWIRE_REQ:-taowire}
    command: ["sh", "-c", "pip install -q $${TAOWIRE_REQ:-taowire} /app && python -m text_ops.validator"]
    depends_on: [miner]
