{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/fastify.ts", "src/redis.ts", "src/sidecar.ts"],
  "out": "docs-api",
  "tsconfig": "tsconfig.build.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "disableSources": true,
  "intentionallyNotExported": ["CATALOGUE", "FORBIDDEN_CODES"]
}
