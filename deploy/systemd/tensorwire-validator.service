# TensorWire validator as a hardened systemd service (spec 5.5, 16.4).
#
# Install (as root; see deploy/README.md, "systemd"):
#   useradd --system --home-dir /var/lib/tensorwire-validator --shell /usr/sbin/nologin tensorwire
#   /opt/tensorwire/venv          the kit + your subnet package (uv sync --frozen --no-dev)
#   /etc/tensorwire/validator.env TW_* settings, mode 0640 root:tensorwire
#   /etc/tensorwire/wallets/<TW_WALLET_NAME>/hotkeys/<TW_WALLET_HOTKEY>
#                                 the hotkey only; directories 0700, file 0600,
#                                 owned by tensorwire. Never the coldkey.
#   install -m 0644 tensorwire-validator.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now tensorwire-validator
#
# Change the module or limits with `systemctl edit tensorwire-validator`, not here.
# Check the sandbox with `systemd-analyze security tensorwire-validator`.

[Unit]
Description=TensorWire validator (docs/validator-guide.md)
# The kit checks the clock against NTP at startup (spec 8.4.4); start after the
# host clock is synchronised (chrony or systemd-timesyncd).
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=tensorwire
Group=tensorwire
Environment=TENSORWIRE_MODULE=text_ops.validator
Environment=TW_WALLET_PATH=/etc/tensorwire/wallets
Environment=TW_STATE_DIR=%S/tensorwire-validator
EnvironmentFile=/etc/tensorwire/validator.env
ExecStart=/opt/tensorwire/venv/bin/python -I -m ${TENSORWIRE_MODULE}
# SIGTERM stops the loop; the running round finishes its writes first.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
# Exit 2 = invalid TW_* settings, 3 = hotkey not registered on the subnet:
# restarting cannot fix either. Other startup refusals (exit 1: chain
# unreachable, clock skew, coldkey present) are retried and then hit the
# start limit above.
RestartPreventExitStatus=2 3

StateDirectory=tensorwire-validator
StateDirectoryMode=0700
# %S = /var/lib (system manager); TW_STATE_DIR above points at the same place.
UMask=0077
LimitNOFILE=65536

# Hardening (spec 16.4). The process needs: outbound TCP to the chain and
# NTP/UDP, outbound TCP to miners, its metrics port, and write access to its state
# directory only (SQLite scores, hotkey lock; spec 8.9).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
