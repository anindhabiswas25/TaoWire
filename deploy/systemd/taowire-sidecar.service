# taowire-sidecar as a hardened systemd service (spec 5.5, 11.6, 16.4): chain
# access for a non-Python miner on the same host. It binds 127.0.0.1 only and
# signs with the miner's hotkey. The `sidecar` command ships in Phase 5.
#
# Install (as root; see deploy/README.md, "systemd"):
#   useradd --system --home-dir /var/lib/taowire-sidecar --shell /usr/sbin/nologin taowire
#   /opt/taowire/venv          the kit (uv sync --frozen --no-dev)
#   /etc/taowire/sidecar.env   TW_* settings, mode 0640 root:taowire
#   /etc/taowire/wallets/<TW_WALLET_NAME>/hotkeys/<TW_WALLET_HOTKEY>
#                                 the hotkey only; directories 0700, file 0600,
#                                 owned by taowire. Never the coldkey.
#   install -m 0644 taowire-sidecar.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now taowire-sidecar
#
# Change limits with `systemctl edit taowire-sidecar`, not here.
# Check the sandbox with `systemd-analyze security taowire-sidecar`.

[Unit]
Description=TaoWire sidecar for a non-Python miner
# The kit checks the clock against NTP at startup (spec 8.4.4); start after the
# host clock is synchronised (chrony or systemd-timesyncd).
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=taowire
Group=taowire
Environment=TW_WALLET_PATH=/etc/taowire/wallets
Environment=TW_STATE_DIR=%S/taowire-sidecar
EnvironmentFile=/etc/taowire/sidecar.env
ExecStart=/opt/taowire/venv/bin/taowire sidecar
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
# Exit 2 = invalid TW_* settings, 3 = hotkey not registered on the subnet:
# restarting cannot fix either. Other startup refusals (exit 1: chain
# unreachable, clock skew, coldkey present) are retried and then hit the
# start limit above.
RestartPreventExitStatus=2 3

StateDirectory=taowire-sidecar
StateDirectoryMode=0700
# %S = /var/lib (system manager); TW_STATE_DIR above points at the same place.
UMask=0077
LimitNOFILE=65536

# Hardening (spec 16.4). The process needs: outbound TCP to the chain and
# NTP/UDP, a loopback TCP port (TW_SIDECAR_PORT, default 9910), and write
# access to its state directory only (the bearer token file).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
